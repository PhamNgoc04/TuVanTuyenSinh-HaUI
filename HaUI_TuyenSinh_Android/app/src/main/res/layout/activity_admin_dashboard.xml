<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#B71C1C"
            app:title="Quản Trị Viên"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Dashboard Tổng Quan"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn mục để quản lý đầy đủ (Xem · Thêm · Sửa · Xóa)"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginBottom="20dp" />

            <!-- ═══ NHÓM 1: Nội dung chính ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 Nội Dung"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#B71C1C"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_gravity="center"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="16dp">

                <!-- Tin Tức -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTinTuc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📰" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tin Tức" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xem · Thêm · Sửa · Xóa" android:textSize="11sp" android:textColor="#B71C1C" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ngành Học -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNganhHoc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎓" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ngành Học" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xem · Thêm · Sửa · Xóa" android:textSize="11sp" android:textColor="#B71C1C" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- ═══ NHÓM 2: Tài chính & Quy trình ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳 Tài Chính &amp; Quy Trình"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#B71C1C"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_gravity="center"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="16dp">

                <!-- Học Phí -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHocPhi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💰" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Học Phí" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xem · Thêm · Sửa · Xóa" android:textSize="11sp" android:textColor="#B71C1C" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Quy Trình -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuyTrinh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quy Trình" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xem · Thêm · Sửa · Xóa" android:textSize="11sp" android:textColor="#B71C1C" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Học Bổng -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHocBong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Học Bổng" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xem · Thêm · Sửa · Xóa" android:textSize="11sp" android:textColor="#B71C1C" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- ═══ NHÓM 3: Chuyên ngành ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Theo Ngành"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#B71C1C"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_gravity="center"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="16dp">

                <!-- Chỉ Tiêu -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardChiTieu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chỉ Tiêu" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Theo từng ngành" android:textSize="11sp" android:textColor="#B71C1C" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nghề Nghiệp -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNgheNghiep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💼" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nghề Nghiệp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Theo từng ngành" android:textSize="11sp" android:textColor="#B71C1C" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Xét Tuyển -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardXetTuyen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📝" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xét Tuyển" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phương thức" android:textSize="11sp" android:textColor="#B71C1C" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- ═══ NHÓM 4: Hệ thống ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Hệ Thống"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#B71C1C"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_gravity="center"
                android:columnOrderPreserved="false">

                <!-- Thông Tin Trường -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThongTinTruong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏫" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thông Tin Trường" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chỉnh sửa hồ sơ" android:textSize="11sp" android:textColor="#B71C1C" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Người Dùng -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNguoiDung"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="32sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tài Khoản" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang bảo trì" android:textSize="11sp" android:textColor="#999999" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
